# Deployment
WEBHOOK_URL=https://your-app.railway.app/api/webhook
DASHBOARD_URL=https://your-app.railway.app/dashboard
PORT=3000

# Environment
NODE_ENV=production
# true = lokaler Betrieb ohne oeffentliche URL (Updates werden aktiv abgeholt).
# Auf dem Server false lassen, sonst wird der Webhook geloescht.
USE_POLLING=false
# true = erkannten OCR-Rohtext im Chat anzeigen (nur zur Fehlersuche)
DEBUG_OCR=false
